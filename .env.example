# Database — SQLite file path (for local development/Docker)
DATABASE_URL="file:./data/claros.db"

# Cloud Database — Turso (libSQL)
TURSO_DATABASE_URL="libsql://claros-db-kishorekrr333.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN=""

# Receipt image storage path (relative to project root)
RECEIPT_STORAGE_PATH="./public/receipts"

# Environment: development | production
NODE_ENV="development"

# Seed demo data on first run (set to "true" in dev)
SEED_DEMO_DATA="false"
